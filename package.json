{
  "name": "xd-local-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "完全本機的 Adobe XD 切版工作台",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build:desktop && vitest run",
    "test:watch": "vitest",
    "check": "npm run build:desktop && tsc --noEmit && vitest run",
    "start": "npm run build && npm run build:desktop && electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:http": "node scripts/http-smoke.mjs",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "dist:win": "node scripts/notices.mjs && npm run build && npm run build:desktop && electron-builder --win portable --x64 --publish never",
    "start:web": "node scripts/serve.mjs",
    "smoke:desktop": "node scripts/test-desktop.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "svg-path-bounds": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/svg-path-bounds": "^1.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "desktop-dist/main.cjs"
}
